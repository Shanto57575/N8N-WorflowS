    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": { \"type\": \"string\" },\n    \"company\": { \"type\": [\"string\", \"null\"] },\n    \"location\": { \"type\": \"string\" },\n    \"experience_level\": {\n      \"type\": \"string\",\n      \"enum\": [\"junior\", \"mid\", \"senior\", \"unknown\"]\n    },\n    \"required_skills\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"maxItems\": 8\n    },\n    \"nice_to_have_skills\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"maxItems\": 5\n    },\n    \"technologies\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"job_type\": {\n      \"type\": \"string\",\n      \"enum\": [\"full-time\", \"part-time\", \"contract\", \"internship\", \"unknown\"]\n    },\n    \"summary\": { \"type\": \"string\", \"maxLength\": 300 },\n    \"apply_link\": { \"type\": \"string\" }\n  },\n  \"required\": [\n    \"title\",\n    \"company\",\n    \"location\",\n    \"experience_level\",\n    \"required_skills\",\n    \"nice_to_have_skills\",\n    \"technologies\",\n    \"job_type\",\n    \"summary\",\n    \"apply_link\"\n  ],\n  \"additionalProperties\": false\n}",
        "autoFix": true
