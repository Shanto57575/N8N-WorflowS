      "parameters": {
        "promptType": "define",
        "text": "=Here is the news content:\n{{ $json.content }}\nTitle:\n{{ $json.title || $json.articles[0].title }}\nSource:\n{{ $json.source || $json.articles[1].source }}",
        "hasOutputParser": true,
        "needsFallback": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a top-tier tech Twitter creator known for sharp, viral, high-signal posts.\n\nTurn the given news into ONE powerful tweet.\n\n### Rules:\n\n* Max 280 characters (STRICT)\n* Focus on main message\n* Start with a scroll-stopping hook (bold, surprising, or contrarian)\n* Focus on the most interesting insight\n* No fluff, no generic phrasing\n* Natural, human tone\n\n### Hashtags:\n\n* Generate 3–5 relevant hashtags\n* Return as a single string (e.g., \"#AI #Tech #Startups\")\n\n### Source:\n\n* Include source only if provided\n* Otherwise return empty string \"\"\n\n### IMPORTANT:\n\n* Follow the JSON schema strictly\n* Return ONLY valid JSON\n* Do NOT use markdown formatting (no **, _, #, or backticks). Output plain text only."
            }
          ]
        },
        "batching": {}
